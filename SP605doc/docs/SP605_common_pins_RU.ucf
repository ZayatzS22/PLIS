# SP605 / XC6SLX45T-3FGG484 — часто используемые выводы
# Источник: Xilinx/AMD UG526 v1.9.
# ВАЖНО: имена в кавычках должны совпадать с портами верхнего Verilog-модуля.

# ---------------------------------------------------------------------------
# ТАКТОВЫЕ СИГНАЛЫ
# ---------------------------------------------------------------------------

# Однотактный генератор X2, обычно установлен на 27 МГц.
# NET "clk_27mhz" LOC = "AB13";

# Дифференциальный системный генератор U6, 200 МГц.
# Для него в Verilog обычно используют входной буфер IBUFGDS.
# NET "sysclk_p" LOC = "K21";
# NET "sysclk_n" LOC = "K22";

# Внешний дифференциальный такт через SMA.
# NET "sma_clk_p" LOC = "M20";   # J41
# NET "sma_clk_n" LOC = "M19";   # J38

# ---------------------------------------------------------------------------
# USB-UART, мост CP2103, разъём Mini-USB J23
# ---------------------------------------------------------------------------

# Передача от FPGA к компьютеру:
# FPGA TX -> CP2103 RX -> USB -> ПК
# NET "uart_tx" LOC = "B21";

# Приём FPGA от компьютера:
# ПК -> USB -> CP2103 TX -> FPGA RX
# NET "uart_rx" LOC = "H17";

# Аппаратное управление потоком, для обычного UART 8N1 обычно не нужно.
# NET "uart_rts" LOC = "F18";
# NET "uart_cts" LOC = "F19";

# ---------------------------------------------------------------------------
# ПОЛЬЗОВАТЕЛЬСКИЕ СВЕТОДИОДЫ — АКТИВНЫ ВЫСОКИМ УРОВНЕМ
# ---------------------------------------------------------------------------

# NET "led0" LOC = "D17";   # DS3 / GPIO_LED_0
# NET "led1" LOC = "AB4";   # DS4 / GPIO_LED_1
# NET "led2" LOC = "D21";   # DS5 / GPIO_LED_2
# NET "led3" LOC = "W15";   # DS6 / GPIO_LED_3

# ---------------------------------------------------------------------------
# ПОЛЬЗОВАТЕЛЬСКИЕ КНОПКИ — ПРИ НАЖАТИИ ДАЮТ ЛОГИЧЕСКУЮ 1
# ---------------------------------------------------------------------------

# NET "button0"   LOC = "F3";   # SW4 / GPIO_BUTTON_0
# NET "button1"   LOC = "G6";   # SW7 / GPIO_BUTTON_1
# NET "button2"   LOC = "F5";   # SW5 / GPIO_BUTTON_2
# NET "button3"   LOC = "C1";   # SW8 / GPIO_BUTTON_3
# NET "cpu_reset" LOC = "H8";   # SW6 / CPU_RESET

# ---------------------------------------------------------------------------
# DIP-ПЕРЕКЛЮЧАТЕЛЬ S2 — АКТИВЕН ВЫСОКИМ УРОВНЕМ
# ---------------------------------------------------------------------------

# NET "switch0" LOC = "C18";   # S2.1
# NET "switch1" LOC = "Y6";    # S2.2
# NET "switch2" LOC = "W6";    # S2.3
# NET "switch3" LOC = "E4";    # S2.4

# ---------------------------------------------------------------------------
# ПОЛЬЗОВАТЕЛЬСКИЙ РАЗЪЁМ J55
# ---------------------------------------------------------------------------

# NET "gpio_hdr0" LOC = "G7";   # J55.1
# NET "gpio_hdr1" LOC = "H6";   # J55.2
# NET "gpio_hdr2" LOC = "D1";   # J55.3
# NET "gpio_hdr3" LOC = "R7";   # J55.4
# J55.5 = GND
# J55.6 = 3.3 V

# ---------------------------------------------------------------------------
# ПРИМЕР ДЛЯ ВАШЕГО ТЕСТА UART
# ---------------------------------------------------------------------------

NET "clk"     LOC = "AB13";  # X2, 27 МГц
NET "reset"   LOC = "F5";    # SW5, при нажатии reset = 1
NET "led"     LOC = "AB4";   # DS4, загорается при led = 1
NET "uart_tx" LOC = "B21";   # Передача FPGA -> ПК через CP2103

# Ограничение периода для 27 МГц:
NET "clk" TNM_NET = "clk";
TIMESPEC "TS_clk" = PERIOD "clk" 37.037 ns HIGH 50%;
